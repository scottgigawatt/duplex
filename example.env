#
# example.env: Complete example environment for the primary Duplex stack.
#

#
# Compose project name used to namespace containers and the shared network.
#
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-duplex}

#
# Private network allocation. Change the complete group together if any range
# overlaps an existing Docker, VPN, or LAN route.
#
COMPOSE_NETWORK_SUBNET="${COMPOSE_NETWORK_SUBNET:-172.30.0.0/16}"
COMPOSE_NETWORK_IP_RANGE="${COMPOSE_NETWORK_IP_RANGE:-172.30.5.0/24}"
COMPOSE_NETWORK_GATEWAY="${COMPOSE_NETWORK_GATEWAY:-172.30.5.254}"

#
# Writable Duplex state root for service configuration, logs, and databases.
#
HOST_DUPLEX_CONFIG="${HOST_DUPLEX_CONFIG:-/volume1/docker/duplex/config}"

#
# Existing Plex application-data directory. It must contain Plex's Cache,
# Metadata, and Plug-in Support directories.
#
HOST_PLEX_CONFIG="${HOST_PLEX_CONFIG:-/volume1/PlexMediaServer/AppData/Plex Media Server}"

#
# JSON log rotation limits shared by every service.
#
LOG_MAX_SIZE="${LOG_MAX_SIZE:-50M}"
LOG_MAX_FILE="${LOG_MAX_FILE:-3}"

#
# IANA timezone shared by service logs and schedules.
#
TZ="${TZ:-America/New_York}"

#
# Versioned Kometa image.
#
KOMETA_IMAGE="${KOMETA_IMAGE:-kometateam/kometa:v2.4.6}"

#
# Kometa diagnostics and comma-separated daily run times.
#
KOMETA_DEBUG="${KOMETA_DEBUG:-false}"
KOMETA_TIMES="${KOMETA_TIMES:-05:00,17:00}"

#
# Versioned ImageMaid image. Application behavior is configured separately in
# config/imagemaid/.env.
#
IMAGEMAID_IMAGE="${IMAGEMAID_IMAGE:-kometateam/imagemaid:v1.2.0}"

#
# PATTRMM image. Upstream publishes only floating channel tags, so the reviewed
# latest image is pinned to an immutable digest.
#
PATTRMM_IMAGE="${PATTRMM_IMAGE:-ghcr.io/insertdisc/pattrmm:latest@sha256:343c7ad56d9ac9ce8fa0e33af6fa03fa5514c3dc7fe667a4d1994a6f818a8b2c}"

#
# PATTRMM daily run time and Synology host user/group identity.
#
PATTRMM_TIME="${PATTRMM_TIME:-02:00}"
PATTRMM_PUID="${PATTRMM_PUID:-1000}"
PATTRMM_PGID="${PATTRMM_PGID:-1000}"

#
# Versioned Tautulli image.
#
TAUTULLI_IMAGE="${TAUTULLI_IMAGE:-tautulli/tautulli:v2.17.2}"

#
# Tautulli Synology host identity and published web-interface port.
#
TAUTULLI_PUID="${TAUTULLI_PUID:-1029}"
TAUTULLI_PGID="${TAUTULLI_PGID:-100}"
TAUTULLI_PORT="${TAUTULLI_PORT:-8181}"

#
# Versioned Notifiarr image and published web-interface port.
#
NOTIFIARR_IMAGE="${NOTIFIARR_IMAGE:-golift/notifiarr:0.9.5}"
NOTIFIARR_PORT="${NOTIFIARR_PORT:-5454}"

#
# Versioned maintained Watchtower image and polling interval in seconds.
#
WATCHTOWER_IMAGE="${WATCHTOWER_IMAGE:-nickfedor/watchtower:1.20.3}"
WATCHTOWER_POLL_INTERVAL="${WATCHTOWER_POLL_INTERVAL:-86400}"

#
# Update lifecycle policy. Label filtering is the primary safety boundary;
# stopped containers remain stopped unless both stopped-container options are
# deliberately changed.
#
WATCHTOWER_CLEANUP="${WATCHTOWER_CLEANUP:-true}"
WATCHTOWER_INCLUDE_STOPPED="${WATCHTOWER_INCLUDE_STOPPED:-false}"
WATCHTOWER_REVIVE_STOPPED="${WATCHTOWER_REVIVE_STOPPED:-false}"
WATCHTOWER_LABEL_ENABLE="${WATCHTOWER_LABEL_ENABLE:-true}"

#
# Shoutrrr notification provider and destination. Replace both placeholders in
# the Discord URL, or select another provider supported by Watchtower.
#
WATCHTOWER_NOTIFICATIONS="${WATCHTOWER_NOTIFICATIONS:-shoutrrr}"
WATCHTOWER_NOTIFICATION_URL="${WATCHTOWER_NOTIFICATION_URL:-discord://replace-with-token@replace-with-webhook-id}"

#
# Docker registry credential directory mounted read-only at /config. It may be
# empty for public images or contain config.json for private registry access.
#
WATCHTOWER_DOCKER_CONFIG="${WATCHTOWER_DOCKER_CONFIG:-/volume1/docker/.docker}"
