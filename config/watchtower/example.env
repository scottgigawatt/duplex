#
# example.env: Complete example environment for one-shot Watchtower updates.
#

#
# Compose project name used to namespace the one-shot container.
#
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-watchtower}

#
# Versioned maintained Watchtower image.
#
WATCHTOWER_IMAGE="${WATCHTOWER_IMAGE:-nickfedor/watchtower:1.21.2}"

#
# JSON log rotation limits for the one-shot container.
#
LOG_MAX_SIZE="${LOG_MAX_SIZE:-50M}"
LOG_MAX_FILE="${LOG_MAX_FILE:-3}"

#
# IANA timezone used in logs and notification timestamps.
#
TZ="${TZ:-America/New_York}"

#
# Update selection and lifecycle policy. Label filtering prevents the one-shot
# chart from updating containers that have not explicitly opted in.
#
WATCHTOWER_CLEANUP="${WATCHTOWER_CLEANUP:-true}"
WATCHTOWER_INCLUDE_STOPPED="${WATCHTOWER_INCLUDE_STOPPED:-false}"
WATCHTOWER_REVIVE_STOPPED="${WATCHTOWER_REVIVE_STOPPED:-false}"
WATCHTOWER_LABEL_ENABLE="${WATCHTOWER_LABEL_ENABLE:-true}"

#
# Shoutrrr notification provider and destination. Replace both placeholders in
# the Discord URL, or select another provider supported by Watchtower.
#
WATCHTOWER_NOTIFICATIONS="${WATCHTOWER_NOTIFICATIONS:-shoutrrr}"
WATCHTOWER_NOTIFICATION_URL="${WATCHTOWER_NOTIFICATION_URL:-discord://replace-with-token@replace-with-webhook-id}"

#
# Exit after one update pass instead of starting the polling daemon.
#
WATCHTOWER_RUN_ONCE="${WATCHTOWER_RUN_ONCE:-true}"

#
# Docker registry credential directory mounted read-only at /config. It may be
# empty for public images or contain config.json for private registry access.
#
WATCHTOWER_DOCKER_CONFIG="${WATCHTOWER_DOCKER_CONFIG:-/volume1/docker/.docker}"
