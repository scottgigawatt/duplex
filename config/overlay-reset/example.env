#
# example.env: Complete example environment for Kometa Overlay Reset.
#

#
# Compose project name used to namespace the one-shot container.
#
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-overlay-reset}

#
# Versioned official Overlay Reset image.
#
OVERLAY_RESET_IMAGE="${OVERLAY_RESET_IMAGE:-kometateam/overlay-reset:v1.0.4}"

#
# Writable host directory mounted at /config for settings and logs.
#
HOST_OVERLAY_RESET_CONFIG="${HOST_OVERLAY_RESET_CONFIG:-/volume1/docker/duplex/config/overlay-reset}"

#
# JSON log rotation limits for the one-shot container.
#
LOG_MAX_SIZE="${LOG_MAX_SIZE:-50M}"
LOG_MAX_FILE="${LOG_MAX_FILE:-3}"

#
# IANA timezone used in logs.
#
TZ="${TZ:-America/New_York}"

#
# Plex connection and target library. Use a scoped Plex token rather than an
# administrator password.
#
PLEX_URL="http://replace-with-plex-host:32400"
PLEX_TOKEN="replace-with-plex-token"
PLEX_LIBRARY="Movies"

#
# Optional Kometa asset and original-artwork directories. Leave empty when the
# corresponding source is not part of the recovery plan.
#
KOMETA_ASSET=""
KOMETA_ORIGINAL=""

#
# TMDb API key used when the selected recovery mode consults TMDb artwork.
#
TMDBAPI="replace-with-tmdb-api-key"

#
# Optional selection filters. START names the first Plex title to process,
# ITEMS accepts pipe-separated titles, and LABELS accepts pipe-separated
# additional labels to remove. Empty values retain the normal library-wide run.
#
START=""
ITEMS=""
LABELS=""

#
# Network request timeout in seconds and TLS verification policy. Disabling TLS
# verification should be limited to a controlled troubleshooting session.
#
TIMEOUT="600"
NO_VERIFY_SSL="False"

#
# Destructive-operation guard. Keep DRY_RUN enabled until the complete proposed
# change set has been reviewed in the logs.
#
DRY_RUN="True"

#
# Artwork layout and poster-level controls. KOMETA_FLAT selects flat asset
# paths; NO_MAIN skips main movie/show posters; SEASON and EPISODE include those
# poster levels; IGNORE_RESUME bypasses an automatically detected resume point.
#
KOMETA_FLAT="False"
NO_MAIN="False"
SEASON="True"
EPISODE="True"
IGNORE_RESUME="False"

#
# Diagnostic logging. Enable only while troubleshooting because request logs
# can contain private endpoints and identifiers.
#
TRACE="False"
LOG_REQUESTS="False"
