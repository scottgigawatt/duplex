#
# example.env: ImageMaid application settings loaded from /config/.env.
#

#
# Plex connection and container mount. The /plex path is supplied by the
# primary Compose chart and must point to Plex application data on the host.
#
PLEX_PATH="/plex"
PLEX_URL="http://replace-with-plex-host:32400"
PLEX_TOKEN="replace-with-plex-token"

#
# Default operation and scheduled overrides. Move mode stores removed metadata
# images in ImageMaid's restore directory. Scheduled entries are comma-separated
# and use ImageMaid's time|frequency|options syntax.
#
# The sample schedule clears the restore directory at 08:00 each Sunday, moves
# eligible images at 09:00 each Sunday, and clears PhotoTranscoder at 10:00 on
# the first day of each month. Clear mode is irreversible; review the schedule
# and timezone before deploying it.
#
MODE="move"
SCHEDULE="08:00|weekly(sunday)|mode=clear,09:00|weekly(sunday)|mode=move,10:00|monthly(1)|mode=nothing;photo-transcoder=true"

#
# Restrict metadata inspection to overlay-related files when enabled.
#
OVERLAYS_ONLY="False"

#
# Optional Discord webhook destination. Leave empty to disable notifications.
#
DISCORD=""

#
# Request timeout, TLS verification policy, and pause between Plex maintenance
# operations. Disable TLS verification only for controlled troubleshooting.
#
TIMEOUT=600
NO_VERIFY_SSL="False"
SLEEP=60

#
# Plex database source and reuse policy. The defaults download a fresh database
# through the Plex API and stop if temporary SQLite files indicate Plex is
# actively writing. USE_EXISTING permits a cached database less than two hours
# old; LOCAL_DB copies the database from PLEX_PATH instead.
#
IGNORE_RUNNING="False"
LOCAL_DB="False"
USE_EXISTING="False"

#
# Remove the Plex PhotoTranscoder cache in addition to metadata image work.
#
PHOTO_TRANSCODER="True"

#
# Plex maintenance actions performed after the selected image operation.
#
EMPTY_TRASH="True"
CLEAN_BUNDLES="True"
OPTIMIZE_DB="True"

#
# Diagnostic request logging. Enable only while troubleshooting because it
# increases log volume and may expose private endpoint details.
#
TRACE="False"
LOG_REQUESTS="False"
